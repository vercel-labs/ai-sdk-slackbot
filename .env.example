# Slack Credentials
# Get these from your Slack app configuration at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token        # Bot User OAuth Token from OAuth & Permissions
SLACK_SIGNING_SECRET=your-signing-secret   # Signing Secret from Basic Information

# Model provider (defaults to OpenAI gpt-4o)
# Get this from your OpenAI account at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o

# Optional: run a local model via Ollama instead (offline, free; local dev only
# — a deployed function can't reach localhost). Requires Ollama running and
# `ollama pull llama3.1`. See README.
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1

# Exa API key (for web search)
EXA_API_KEY=your-exa-api-key

# Policy backend for @ai-sdk/policy-opa (OPA). See policies/README.md.
# Default is wasm — in-process, no extra process required. `pnpm policy:build`
# refreshes policies/policy.wasm after editing decision.rego.
# Switch to POLICY_MODE=http for live policy hot-reload during iteration:
#   opa run --server --addr :8181 ./policies
# POLICY_MODE=wasm                            # wasm (default) | http
# OPA_URL=http://localhost:8181               # only used when POLICY_MODE=http
# POLICY_WASM_PATH=policies/policy.wasm       # override default WASM lookup